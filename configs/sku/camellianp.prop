# Per-SKU identity. Imported from vendor.prop via
#   import /vendor/etc/${ro.boot.product.hardware.sku}.prop
# Values taken from stock MIUI 14 V14.0.6.0.TKSMIXM /vendor/build_camellianp.prop.
#
# Only ro.product.vendor.* / ro.vendor.* / ro.product.board appear here. Stock
# sets more in this file, but those lines are silently dropped at boot on our
# build: /vendor/etc/*.prop loads in vendor_init context, and build_prop /
# build_bootimage_prop are system_restricted_prop with no set_prop(vendor_init)
# grant anywhere in the tree. Removed rather than left to fail:
#   ro.product.brand, ro.bootimage.build.fingerprint,
#   ro.system_ext.build.fingerprint, ro.product.system_ext.{model,brand}
# marketname and cert are NOT settable here either - they match no rule in
# property_contexts and land on default_prop, which vendor_init also cannot
# write. They need a device-side label; see the libinit variant work.
#
# NOTE: this file cannot fix ro.product.model/brand/device/name. Those derive
# from ro.product.property_source_order = odm,vendor,... and odm wins. libinit
# is the real fix.

ro.product.vendor.brand=POCO
ro.product.vendor.device=camellian
ro.product.vendor.model=M2103K19PG
ro.product.vendor.name=camellian_p_global
ro.vendor.build.fingerprint=POCO/camellian_p_global/camellian:12/SP1A.210812.016/V14.0.6.0.TKSMIXM:user/release-keys
ro.product.board=camellian
