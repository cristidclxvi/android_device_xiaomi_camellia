rw_dir_file(vendor_init, sysfs_leds)
rw_dir_file(vendor_init, sysfs_ged)

# AOSP labels the whole vendor. namespace vendor_default_prop and lets
# vendor_init write it, which is how stock gets its three MDP image quality
# switches out of /vendor/build.prop. Our own property_contexts moves the
# vendor.camera. prefix into vendor_camera_prop so mtk_hal_camera owns it,
# and that took the write away from init: vendor.camera.mdp.{cz,dre,hfg}
# .enable were dropped at boot and read back empty. MediaTek grants exactly
# this for its own equivalent type in sepolicy_vndr.
set_prop(vendor_init, vendor_camera_prop)

# The modem File Service Daemon inside ccci_mdinit hard-codes ten host
# roots; the tenth is /data/vendor_de/md, created by init.cccimdinit.rc.
# Android 14 split /data/vendor_de off as vendor_userdir_file and limited
# directory creation there to vold, so on Android 16 the directory never
# appears and every FSD operation rooted there fails. Stock MIUI 14, which
# these blobs were built for, labelled the tree vendor_data_file and the
# mkdir succeeded.
#
# data_between_core_and_vendor_violators is AOSP's designated exemption
# for exactly this class of pre-14 vendor code; it only lifts the
# compile-time neverallow and grants nothing on its own. The allow below
# is the whole runtime widening - create, not delete. The contents are
# already labelled and covered by the MediaTek policy.
typeattribute vendor_init data_between_core_and_vendor_violators;
allow vendor_init vendor_userdir_file:dir { write add_name };
