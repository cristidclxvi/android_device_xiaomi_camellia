# ZRAM writeback
# zram writeback tunables omitted on purpose: CONFIG_ZRAM_WRITEBACK is not
# set, so the idle/writeback sysfs nodes these drive do not exist.

# ---------------------------------------------------------------------------
# Hardware capability flags recovered from the stock vendor build.prop
# (V14.0.6.0.TKSMIXM). Our vendor.prop carried 204 properties against stock 536;
# the MediaTek HALs we ship read these at runtime to decide which features to
# enable. Without them the hardware is present but silently disabled.
#
# Deliberately NOT copied: Xiaomi audio-effect props (ro.vendor.audio.soundfx.*,
# .sos, .spk.clean, .vocal.*, .voice.change.*, .surround.*) because they load
# MIUI effect libraries we do not ship; ro.vendor.mtk_prefer_64bit_proc because
# it conflicts with ZYGOTE_FORCE_64; and all identity/logging properties.
# Added 2026-08-02.
# ---------------------------------------------------------------------------

# Telephony / radio
# ro.telephony.sim.count omitted on purpose: same default_prop neverallow as
# above, and stock drops it too. DSDS comes from
# persist.radio.multisim.config=dsds, which does take effect.
ro.vendor.radio.5g=3
ro.vendor.radio.features_common=2
ro.vendor.radio.max.multisim=dsds
persist.vendor.radio.enable_temp_dds=true
ro.vendor.mtk_modem_monitor_support=1
ro.vendor.mtk_wappush_support=1

# Location
ro.vendor.mtk_gps_support=1
ro.vendor.mtk_agps_app=1

# Sensors — selects the sensor init script, which is byte-identical to stock
ro.vendor.mtk.sensor.support=yes
ro.vendor.init.sensor.rc=init.sensor_2_0.rc

# NFC
ro.vendor.mtk_nfc_addon_support=1

# Display
ro.vendor.display.sensortype=2
ro.vendor.display.svi=1

# Audio (MediaTek-level only)
ro.vendor.mtk_hifiaudio_support=1
ro.vendor.mtk_besloudness_support=1
ro.vendor.mtk_audio_alac_support=1
ro.vendor.mtk_audio_ape_support=1
ro.vendor.mtk_audio_tuning_tool_ver=V2.2

# Media / DRM
ro.vendor.mtk_widevine_drm_l1_support=1
ro.vendor.mtk_wfd_support=1
ro.vendor.mtk_slow_motion_support=1

# Connectivity
ro.vendor.mtk_wapi_support=1
ro.vendor.bluetooth.bt_multidevice_perform=600

# Storage
ro.vendor.mtk_ufs_support=1
ro.vendor.mtk_f2fs_enable=1

# MediaTek platform version - some HALs gate behaviour on these
ro.vendor.mediatek.version.branch=alps-mp-s0.mp1.tc8sp-mt6785
ro.vendor.mediatek.version.release=alps-mp-s0.mp1.tc8sp-mt6785-V1.12.13_xiaomi.s0mp1.k85v1.64_P62
