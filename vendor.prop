# GNSS
ro.vendor.gps.chrdev=gps_drv
ro.vendor.mtk_log_hide_gps=1

# Keymaster
ro.crypto.volume.filenames_mode=aes-256-cts
ro.hardware.kmsetkey=beanpod

# Low memory killer daemon
# Stock's PSI tuning, minus the values that do not suit this device. PSI is
# live here (CONFIG_PSI=y), so lmkd runs its PSI strategy and these apply.
#
# Deliberately NOT taken from stock:
#   ro.lmk.kill_timeout_ms=100      - already lmkd's built-in default.
#   ro.lmk.thrashing_limit=30       - AOSP's low-RAM figure. On 6 GB it also
#   ro.lmk.thrashing_limit_decay=50   drags thrashing_limit_critical 300 -> 90,
#                                     which is the aggressive background-app
#                                     killing this ROM exists to avoid. Needs a
#                                     deliberate experiment, not a copy.
ro.lmk.psi_complete_stall_ms=300
ro.lmk.swap_free_low_percentage=20
ro.lmk.swap_util_max=90

