 ndk::ScopedAStatus SunlightEnhancement::setEnabled(bool enabled) {
-    if (!WriteStringToFile(enabled ? std::to_string(static_cast<int32_t>(enabled_mode_)) : "0",
+    // Some panels expose graded HBM levels where the enum value 1 is the NORMAL
+    // backlight current (a no-op) and the real boosts are higher. SE_ENABLED_VALUE
+    // lets a device pick the level to write. MT6833/camellia: 1 = 21.8mA (default),
+    // 2 = 25mA, 3 = 27.4mA -- writing 1 looks like HBM does nothing.
+#ifdef SE_ENABLED_VALUE
+    const int32_t on_value = SE_ENABLED_VALUE;
+#else
+    const int32_t on_value = static_cast<int32_t>(enabled_mode_);
+#endif
+    if (!WriteStringToFile(enabled ? std::to_string(on_value) : "0",
                            file_, true)) {
         LOG(ERROR) << "Failed to set SunlightEnhancement state";
         return ndk::ScopedAStatus::fromExceptionCode(EX_SERVICE_SPECIFIC);
