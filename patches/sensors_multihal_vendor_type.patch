diff --git a/sensors/aidl/convert/convert.cpp b/sensors/aidl/convert/convert.cpp
index 940699c831..e2b5e9dc52 100644
--- a/sensors/aidl/convert/convert.cpp
+++ b/sensors/aidl/convert/convert.cpp
@@ -283,7 +283,10 @@ void convertToSensorEvent(const Event& src, sensors_event_t* dst) {
             break;
 
         default: {
-            CHECK_GE((int32_t)src.sensorType, (int32_t)SensorType::DEVICE_PRIVATE_BASE);
+            // Vendors may report sensor types below DEVICE_PRIVATE_BASE;
+            // Xiaomi camellia emits type 75. Upstream asserts otherwise and
+            // CHECK_GE becomes LOG(FATAL), which kills the whole process. The
+            // raw copy below handles an arbitrary type, so let it through.
 
             memcpy(dst->data, src.payload.get<Event::EventPayload::data>().values.data(),
                    16 * sizeof(float));
@@ -490,7 +493,10 @@ void convertFromSensorEvent(const sensors_event_t& src, Event* dst) {
         }
 
         default: {
-            CHECK_GE((int32_t)dst->sensorType, (int32_t)SensorType::DEVICE_PRIVATE_BASE);
+            // Vendors may report sensor types below DEVICE_PRIVATE_BASE;
+            // Xiaomi camellia emits type 75. Upstream asserts otherwise and
+            // CHECK_GE becomes LOG(FATAL), which kills the whole process. The
+            // raw copy below handles an arbitrary type, so let it through.
 
             Event::EventPayload::Data data;
             memcpy(data.values.data(), src.data, 16 * sizeof(float));
diff --git a/sensors/aidl/default/multihal/ConvertUtils.cpp b/sensors/aidl/default/multihal/ConvertUtils.cpp
index 9f28a8107a..9b256e4e5f 100644
--- a/sensors/aidl/default/multihal/ConvertUtils.cpp
+++ b/sensors/aidl/default/multihal/ConvertUtils.cpp
@@ -226,7 +226,10 @@ void convertToHidlEvent(const AidlEvent& aidlEvent, V2_1Event* hidlEvent) {
             break;
         }
         default: {
-            CHECK_GE((int32_t)aidlEvent.sensorType, (int32_t)SensorType::DEVICE_PRIVATE_BASE);
+            // Vendors may report sensor types below DEVICE_PRIVATE_BASE;
+            // Xiaomi camellia emits type 75. Upstream asserts otherwise and
+            // CHECK_GE becomes LOG(FATAL), which kills the whole process. The
+            // raw copy below handles an arbitrary type, so let it through.
             std::copy(std::begin(aidlEvent.payload.get<AidlEvent::EventPayload::data>().values),
                       std::end(aidlEvent.payload.get<AidlEvent::EventPayload::data>().values),
                       hidlEvent->u.data.data());
@@ -408,7 +411,13 @@ void convertToAidlEvent(const V2_1Event& hidlEvent, AidlEvent* aidlEvent) {
             break;
         }
         default: {
-            CHECK_GE((int32_t)hidlEvent.sensorType, (int32_t)V2_1SensorType::DEVICE_PRIVATE_BASE);
+            // Some vendors report sensor types below DEVICE_PRIVATE_BASE for
+            // their own sensors; Xiaomi camellia emits type 75. Upstream
+            // asserts that anything unrecognised must be >= DEVICE_PRIVATE_BASE
+            // and CHECK_GE turns that into LOG(FATAL), so one such event aborts
+            // the whole sensors HAL and it crash-loops at boot. The payload copy
+            // below already handles an arbitrary type, so pass the event through
+            // rather than killing the process.
             AidlEvent::EventPayload::Data data;
             std::copy(hidlEvent.u.data.data(), hidlEvent.u.data.data() + hidlEvent.u.data.size(),
                       std::begin(data.values));
